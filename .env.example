# Root convenience example. Copy values into backend/.env and frontend/.env as needed.

# Backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnas_assembler

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
SAM_GOV_API_KEY=replace-with-your-sam-gov-api-key
